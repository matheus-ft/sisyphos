{
  "name": "sisyphos",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "vitest run tests/smoke.live.test.ts --mode smoke --reporter=verbose",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "hooks:install": "git config core.hooksPath .githooks",
    "lint": "eslint .",
    "verify": "npm run check && npm run lint && npm test && npm run format:check"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^24.13.3",
    "eslint": "^10.12.0",
    "eslint-plugin-svelte": "^3.23.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.13.0",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.0",
    "vite": "^7.3.6",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "idb": "^8.0.3"
  }
}
